REDIS_URL=redis://localhost:6379/0
APP_ENV=development
APP_API_PORT=18080
AUTO_LOAD_DEMO_KNOWLEDGE=true
CORS_ORIGINS=*

# 前端默认会自动使用当前浏览器主机的 18080 端口。
# 如果前后端分开部署，可以显式指定。
VITE_API_BASE=http://localhost:18080

# 默认不调用大模型，保证 demo 和测试稳定。
# 接本地 vLLM / Qwen OpenAI-compatible 服务时打开下面配置。
RAG_USE_LLM=false
LLM_API_BASE=http://192.168.27.250:18003/v1
LLM_MODEL=Qwen3.6-27B
LLM_API_KEY=qwen-local-key
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
LLM_SEND_CHAT_TEMPLATE_KWARGS=true
LLM_ENABLE_THINKING=false

# 本地 Qwen 不可用时的备用模型。把真实 key 填到仓库根目录 `.env`，不要提交到 Git。
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_API_BASE=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_TIMEOUT_SECONDS=45
LLM_FALLBACK_MAX_TOKENS=512
LLM_FALLBACK_SEND_CHAT_TEMPLATE_KWARGS=false
LLM_FALLBACK_SEND_THINKING_PARAM=true
LLM_FALLBACK_ENABLE_THINKING=false
